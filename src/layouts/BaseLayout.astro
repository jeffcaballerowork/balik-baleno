---
import Announcement from "../components/Announcement.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AuthModal from "../components/AuthModal";
import NoteLightbox from "../components/NoteLightbox";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "An independent alumni project for Baleno National High School. Where we always belong.",
} = Astro.props;
const pageTitle =
  title === undefined
    ? "Balik Baleno · Where we always belong"
    : `${title} · Balik Baleno`;
const activePath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/baleno-national-high-school-logo.jpg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Balik Baleno" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/baleno-national-high-school-logo.jpg" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="app-shell">
      <Announcement />
      <Header activePath={activePath} />
      <slot />
      <Footer />
      <AuthModal client:load />
      <NoteLightbox client:idle />
    </div>
  </body>
</html>
