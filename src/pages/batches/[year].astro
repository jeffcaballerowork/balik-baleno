---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BatchPage from "../../components/BatchPage.astro";
import { AUTH_CONFIG } from "../../config";
import { getSessionUser, isApproved } from "../../lib/auth";

export const prerender = false;

const viewer = await getSessionUser(Astro.request);

// Batch pages are for signed-in, approved alumni, like the profiles they lead to.
if (!viewer || !isApproved(viewer)) {
  return Astro.redirect(`/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const year = Number(Astro.params.year ?? "");

if (!Number.isInteger(year) || year < AUTH_CONFIG.batchYearMinimum || year > AUTH_CONFIG.batchYearMaximum) {
  return Astro.redirect("/batches");
}
---

<BaseLayout title={`Class of ${year}`}>
  <BatchPage year={year} />
</BaseLayout>
