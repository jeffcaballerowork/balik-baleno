---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getAllTeachers } from "../../lib/teachers"
import { listSubjects } from "../../lib/teacher-filter"

const teachers = await getAllTeachers()
const subjects = listSubjects(teachers)
---

<BaseLayout title="Teacher Tribute">
  <main class="content-width py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-serif font-bold text-slate-900 mb-4">Teacher Tribute</h1>
      <p class="text-lg text-slate-600">Share a thank-you note with your favorite teachers.</p>
    </header>

    <div class="flex flex-col sm:flex-row gap-3 mb-8" role="search">
      <label class="sr-only" for="teacher-search">Search teachers</label>
      <input
        id="teacher-search"
        type="search"
        placeholder="Search by name or subject…"
        class="w-full sm:flex-1 px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
      />
      <label class="sr-only" for="teacher-subject-filter">Filter by subject</label>
      <select
        id="teacher-subject-filter"
        class="px-4 py-3 border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
      >
        <option value="">All subjects</option>
        {subjects.map(subject => <option value={subject}>{subject}</option>)}
      </select>
    </div>

    <div data-teacher-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {teachers.map(teacher => (
        <a
          href={`/teachers/${teacher.id}`}
          data-teacher-card
          data-name={teacher.name}
          data-subject={teacher.subject ?? ""}
          class="block bg-white p-6 rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-md transition-all"
        >
          <h2 class="text-xl font-bold text-slate-900">{teacher.name}</h2>
          {teacher.subject && <p class="text-slate-600 mt-1 italic">{teacher.subject}</p>}
          <span class="inline-block mt-4 text-sm font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
            View tribute
          </span>
        </a>
      ))}
    </div>

    <p data-teacher-empty hidden class="text-center text-slate-500 py-12">No teachers match your search.</p>

    <nav data-teacher-pagination aria-label="Teacher pagination" class="flex flex-wrap justify-center gap-2 mt-10"></nav>
  </main>
</BaseLayout>

<script>
  import { filterTeachers, paginate, TEACHER_PAGE_SIZE } from "../../lib/teacher-filter"

  const grid = document.querySelector<HTMLElement>("[data-teacher-grid]")
  const searchInput = document.querySelector<HTMLInputElement>("#teacher-search")
  // HTMLSelectElement overrides remove(), which clashes with the global Element that the
  // wrangler-generated runtime types widen; cast instead (same pattern as profile.astro).
  const subjectSelect = document.querySelector("#teacher-subject-filter") as HTMLSelectElement | null
  const pagination = document.querySelector<HTMLElement>("[data-teacher-pagination]")
  const emptyMessage = document.querySelector<HTMLElement>("[data-teacher-empty]")

  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>("[data-teacher-card]")) : []
  const entries = cards.map(card => ({
    name: card.dataset.name ?? "",
    subject: card.dataset.subject || null,
    card,
  }))

  let currentPage = 1

  function makePageButton(
    label: string,
    page: number,
    options: { active?: boolean; disabled?: boolean } = {},
  ): HTMLButtonElement {
    const button = document.createElement("button")
    button.type = "button"
    button.textContent = label
    button.className = options.active
      ? "h-10 min-w-10 px-3 rounded-lg border border-indigo-600 bg-indigo-600 text-white font-semibold"
      : "h-10 min-w-10 px-3 rounded-lg border border-slate-300 bg-white text-slate-700 hover:border-indigo-400 disabled:opacity-40 disabled:hover:border-slate-300"
    if (options.active) button.setAttribute("aria-current", "page")
    button.disabled = options.disabled ?? false
    button.addEventListener("click", () => {
      currentPage = page
      render()
    })
    return button
  }

  function render(): void {
    const query = searchInput?.value ?? ""
    const subject = subjectSelect?.value ?? ""
    const filtered = filterTeachers(entries, query, subject)
    const result = paginate(filtered, currentPage, TEACHER_PAGE_SIZE)
    currentPage = result.page

    const visible = new Set(result.items.map(item => item.card))
    for (const card of cards) card.style.display = visible.has(card) ? "" : "none"

    if (emptyMessage) emptyMessage.hidden = filtered.length > 0

    if (pagination) {
      pagination.replaceChildren()

      if (result.pageCount > 1) {
        pagination.appendChild(makePageButton("Previous", result.page - 1, { disabled: result.page === 1 }))

        for (let index = 1; index <= result.pageCount; index += 1) {
          pagination.appendChild(makePageButton(String(index), index, { active: index === result.page }))
        }

        pagination.appendChild(makePageButton("Next", result.page + 1, { disabled: result.page === result.pageCount }))
      }
    }
  }

  function resetAndRender(): void {
    currentPage = 1
    render()
  }

  searchInput?.addEventListener("input", resetAndRender)
  subjectSelect?.addEventListener("change", resetAndRender)
  render()
</script>
