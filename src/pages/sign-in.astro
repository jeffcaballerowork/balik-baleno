---
import BaseLayout from "../layouts/BaseLayout.astro"
import AuthModal from "../components/AuthModal"
---

<BaseLayout title="Sign in">
  <main class="auth-page content-width">
    <p class="eyebrow"><span class="eyebrow-line"></span> ALUMNI ACCESS</p>
    <h1>Welcome back, Balik Baleno Alumnus!</h1>
    <p>You're already signed in – let's get started.</p>
    <button class="button button-primary" id="open-auth-modal">Sign in with Google</button>
    <p class="auth-message" id="auth-message" aria-live="polite"></p>
  </main>
  
  <AuthModal client:visible />
</BaseLayout>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("#open-auth-modal")
  const message = document.querySelector<HTMLElement>("#auth-message")

  openButton?.addEventListener("click", () => {
    // Open the AuthModal via global function
    if ((window as any).openAuthModal) {
      (window as any).openAuthModal()
    }
  })

  // Hide the Google sign-in button for alumni who are already signed in.
  async function syncSignInButton(): Promise<void> {
    try {
      const response = await fetch("/api/auth/me", { credentials: "same-origin" })
      const body = await response.json() as { user?: unknown }
      if (response.ok && body.user && openButton) {
        openButton.style.display = "none"
      }
    } catch {
      // Leave the button in place if the session cannot be checked.
    }
  }

  void syncSignInButton()
</script>
