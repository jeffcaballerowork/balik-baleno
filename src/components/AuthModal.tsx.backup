import { useState, useEffect } from 'react';

export default function AuthModal() {
  const [isOpen, setIsOpen] = useState(false);
  const [mode, setMode] = useState<'login' | 'register' | 'welcome'>('login');
  const [error, setError] = useState('');
  const [user, setUser] = useState<{ displayName?: string; email?: string } | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    // Check if user is already signed in
    fetch('/api/auth/me', {
      method: 'GET',
      headers: { 'Content-Type': 'application/json' }
    })
      .then(response => response.json() as { user?: { displayName?: string; email?: string } })
      .then(data => {
        if (data.user) {
          // User is signed in - show welcome message
          setUser(data.user);
          setMode('welcome');
        } else {
          // User is not signed in - show login form
          setMode('login');
        }
      })
      .catch(() => {
        // If we can't determine auth status, default to login
        setMode('login');
      })
      .finally(() => {
        setIsLoading(false);
      });

    // Expose open method globally for Header to call
    (window as any).openAuthModal = () => setIsOpen(true);
    // Cleanup on unmount
    return () => { (window as any).openAuthModal = undefined; };
  }, []);

  const handleClose = () => {
    setIsOpen(false);
    setMode('login');
    setError('');
    setUser(null);
  };

  const handleSubmit = async (event: React.SyntheticEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError('');

    try {
      let response: Response;

      if (mode === 'login') {
        response = await fetch('/api/auth/google', {
          method: 'GET',
          credentials: 'same-origin'
        });
      } else {
        // Registration - collect form data
        const form = event.currentTarget as HTMLFormElement;
        const formData = new FormData(form);
        response = await fetch('/api/auth/register', {
          method: 'POST',
          body: formData,
          credentials: 'same-origin'
        });
      }

      const data = await response.json() as { user?: any; message?: string };

      if (response.ok && data.user) {
        // Refresh auth state
        await fetch('/api/auth/me', {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' }
        })
          .then(response => response.json() as { user?: { displayName?: string; email?: string } })
          .then(data => {
            if (data.user) {
              setUser(data.user);
              setMode('welcome');
            }
          })
          .catch(() => {
            setMode('login');
            setUser(null);
          });

        setIsOpen(false);
      } else {
        setError(data.message || 'Authentication failed. Please try again.');
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred. Please try again.');
    }
  };

  if (!isOpen) return null;

  // Show welcome message when signed in
  if (mode === 'welcome' && user) {
    return (
      <div className='auth-modal-overlay'>
        <div className='auth-modal'>
          <button onClick={handleClose} className='auth-modal-close' aria-label='Close modal'>
            <svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='2'>
              <path d='M18 6L6 18M6 6l12 12' strokeLinecap='round' />
            </svg>
          </button>
          <div className='auth-modal-welcome'>
            <h2 className='auth-modal-welcome-title'>Welcome back, {user.displayName || 'Balik Baleno Alumnus'}!</h2>
            <p className='auth-modal-welcome-subtitle'>You're already signed in – let's get started.</p>
            <button onClick={handleClose} className='button button-primary w-full'>
              Continue to Freedom Wall
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className='auth-modal-overlay'>
      <div className='auth-modal'>
        <button onClick={handleClose} className='auth-modal-close' aria-label='Close modal'>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <path d="M18 6L6 18M6 6l12 12" strokeLinecap="round" />
          </svg>
        </button>
        <h2>Join the conversation</h2>
        <p>The Freedom Wall is for Baleno National High School alumni. <span>{mode === 'login' ? 'Sign in' : 'Register'}</span> to start pinning your notes.</p>
        {error && (
          <div className='auth-modal-error' role='alert'>
            {error}
          </div>
        )}
        <div className='auth-modal-body'>
          {mode === 'login' ? (
            <div>
              <a href='/api/auth/google' className='button button-primary w-full auth-google-button'>
                <svg aria-hidden="true" focusable="false" version="1.1" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48" className='auth-google-icon'>
                  <path fill="#EA4335" d="M24 9.5c3.3 0 6.3 1.2 8.7 3.2l6.5-6.5C34.5 2.6 29.8 0 24 0 14.7 0 6.7 5.7 3.2 13.7l7.4 5.8C12.5 12.8 17.8 9.5 24 9.5z"/>
                  <path fill="#4285F4" d="M46.5 24.5c0-1.6-.2-3.1-.5-4.5H24v8.5h12.5c-0.5 2.7-2 5-4.2 6.5l7.4 5.8c4.3-4 6.8-9.9 6.8-16.3z"/>
                  <path fill="#FBBC05" d="M12.5 28.5c-0.7-2-1.1-4.2-1.1-6.5s0.4-4.5 1.1-6.5l-7.4-5.8C2.9 14.5 2 19 2 24s0.9 9.5 3.1 13.8l7.4-5.8z"/>
                  <path fill="#34A853" d="M24 48c6.5 0 11.9-2.2 15.9-6l-7.4-5.8c-2.1 1.4-4.8 2.2-8.5 2.2-6.2 0-11.5-4.2-13.3-9.9l-7.4 5.8C10.7 42.3 16.7 48 24 48z"/>
                </svg>
                Sign in with Google
              </a>
              <p className='auth-modal-divider'>OR</p>
              <button
                type='button'
                onClick={() => setMode('register')}
                className='button button-outline w-full'
              >
                Create account
              </button>
            </div>
          ) : (
            <form onSubmit={handleSubmit} className='register-form'>
              <div className='form-group'>
                <label htmlFor='displayName'>Display name</label>
                <input id='displayName' name='displayName' type='text' required />
              </div>
              <div className='form-group'>
                <label htmlFor='email'>Email</label>
                <input id='email' name='email' type='email' required />
              </div>
              <div className='form-group'>
                <label htmlFor='batchYear'>Batch year</label>
                <input id='batchYear' name='batchYear' type='number' min='1996' max='2026' required />
              </div>
              <div className='form-group'>
                <label htmlFor='connectionNote'>Connection to Baleno</label>
                <textarea id='connectionNote' name='connectionNote' maxLength={500} required />
              </div>
              <button type='submit' className='button button-primary w-full'>Register</button>
              <p className='auth-modal-divider'>OR</p>
              <button
                type='button'
                onClick={() => setMode('register')}
                className='button button-outline w-full'
              >
                Create account
              </button>
            </div>
          ) : (
            <form onSubmit={handleSubmit} className='register-form'>
              <div className='form-group'>
                <label htmlFor='displayName'>Display name</label>
                <input id='displayName' name='displayName' type='text' required />
              </div>
              <div className='form-group'>
                <label htmlFor='email'>Email</label>
                <input id='email' name='email' type='email' required />
              </div>
              <div className='form-group'>
                <label htmlFor='batchYear'>Batch year</label>
                <input id='batchYear' name='batchYear' type='number' min={1996} max={2026} required />
              </div>
              <div className='form-group'>
                <label htmlFor='connectionNote'>Connection to Baleno</label>
                <textarea id='connectionNote' name='connectionNote' maxLength={500} required />
              </div>
              <button type='submit' className='button button-primary w-full'>
                Register and continue
              </button>
            </form>
          )}
        </div>
      </div>
    </div>
  );
}
