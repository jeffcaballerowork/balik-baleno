---
import Icon from "./Icon.astro";

const methods = [
  { label: "GCash", account: "Jeffrey Caballero" },
  { label: "Maribank", account: "Jeffrey Caballero" },
  { label: "GoTyme", account: "Jeffrey Caballero" },
  { label: "BPI", account: "Jeffrey Caballero" },
  { label: "BDO", account: "Jeffrey Caballero" },
];
---

<main class="listing-page content-width">
  <div class="page-heading">
    <span class="eyebrow"><span class="eyebrow-line"></span>{" "}SUPPORT THE SITE</span>
    <h1>Keep the wall <em>standing.</em></h1>
    <p>What this site costs, who pays for it, and how you can help.</p>
  </div>

  <section class="donate-section">
    <h2>What it costs</h2>
    <p>
      This site is a personal project, paid for out of pocket. There is no
      sponsor and no advertising.
    </p>
    <p class="donate-placeholder">
      Placeholder. The honest breakdown — domain, hosting, database, and image
      storage, per month and per year — goes here once the numbers are final.
    </p>
  </section>

  <section class="donate-section">
    <h2>This month</h2>
    <p class="donate-placeholder">
      Placeholder. The monthly goal and the progress bar go here once donation
      records exist. Anonymous donations will count toward the bar; amounts are
      never shown next to a name.
    </p>
  </section>

  <section class="donate-section">
    <h2>How to send it</h2>
    <p>Scan the code for whichever is easiest for you.</p>
    <div class="donate-qr-grid">
      {
        methods.map(method => (
          <div class="donate-qr">
            <img src={`/${method.label.toLowerCase().replace(/\s+/g, "-")}-qr.jpg`} alt={`${method.label} QR`} class="donate-qr-img" />
            <strong>{method.label}</strong>
            <span>{method.account}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="donate-section">
    <h2>Thank you</h2>
    <p class="donate-placeholder">
      Placeholder. The list of supporters who chose to be named goes here.
      Amounts are never shown publicly, and anonymous donors are never named.
    </p>
  </section>

  <p class="donate-more">
    <a class="text-link" href="/about">
      About the author <Icon name="arrow" size={17} />
    </a>
  </p>
</main>
