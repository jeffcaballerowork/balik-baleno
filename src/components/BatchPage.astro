---
import Icon from "./Icon.astro";
import { batchStats, listBatchMembers } from "../lib/batch-db";
import { mediaUrl } from "../lib/media";
import { graduationPhoto } from "../data/mock";

interface Props {
  year: number;
}

const { year } = Astro.props;

const [members, stats] = await Promise.all([listBatchMembers(year), batchStats(year)]);

const initialsOf = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .slice(0, 2)
    .join("");
---

<main class="batch-page content-width">
  <button class="back-link" data-nav="/batches">
    <Icon name="arrowLeft" size={17} /> All batches
  </button>
  <div class="batch-hero">
    <div>
      <span class="eyebrow">THE YEAR WE&apos;LL NEVER FORGET</span>
      <h1>Class of <em>{year}.</em></h1>
      <p>
        Same old stories. A few new chapters. It&apos;s really good to see you again.
      </p>
      <div class="batch-hero-stat">
        <span><strong>{stats.members}</strong> classmates here</span>
        <span><strong>{stats.notes}</strong> memories shared</span>
      </div>
    </div>
    <div class="batch-hero-photo">
      <img src={graduationPhoto} alt="Graduates celebrating together" />
      <span>the good old days ↗</span>
    </div>
  </div>
  <section class="batch-members">
    <div class="section-heading">
      <div>
        <span class="eyebrow"><span class="eyebrow-line"></span>FAMILIAR FACES</span>
        <h2>Look who&apos;s here</h2>
        <p>The names you know, the people you missed.</p>
      </div>
    </div>
    {
      members.length === 0 ? (
        <p class="batch-empty">
          Nobody from this batch has been listed yet. If this is your year, your own profile is the
          first one here.
        </p>
      ) : (
        <div class="member-grid">
          {members.map((member) => (
            <a class="member-card" href={`/alumni/${member.id}`}>
              {mediaUrl(member.avatar_key) ? (
                <img class="member-avatar" src={mediaUrl(member.avatar_key) ?? ""} alt="" />
              ) : (
                <span class="member-avatar member-avatar-initials">{initialsOf(member.display_name)}</span>
              )}
              <div>
                <strong>{member.display_name}</strong>
                <small>Class of {member.batch_year ?? year}</small>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
  <div class="batch-cta">
    <span>Missing someone?</span>
    <p>Leave a note on the wall and let them know you&apos;re thinking of them.</p>
    <button class="button button-primary" data-nav="/create">
      Pin a note <Icon name="arrow" size={18} />
    </button>
  </div>
</main>

<style>
  .batch-empty {
    color: #6b625a;
  }

  .member-card {
    text-decoration: none;
    color: inherit;
  }

  .member-avatar {
    object-fit: cover;
  }
</style>
