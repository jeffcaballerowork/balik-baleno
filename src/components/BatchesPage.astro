---
import Icon from "./Icon.astro";
import { listBatchYears } from "../lib/batch-db";

// Real years with real counts. A year only appears once somebody from it is
// listed, so this page cannot advertise a batch that opens onto nothing.
const years = await listBatchYears();
---

<main class="listing-page content-width">
  <div class="page-heading">
    <span class="eyebrow"><span class="eyebrow-line"></span>{" "}THE YEARS THAT MADE US</span>
    <h1>Find your <em>batch.</em></h1>
    <p>
      Different years, same place in our hearts. Find your people and pick up where you left off.
    </p>
  </div>
  {
    years.length === 0 ? (
      <p class="batches-empty">
        No batches have anyone listed yet. Set your batch year on your own profile and yours shows up
        here.
      </p>
    ) : (
      <div class="batches-grid">
        {years.map(({ year, count }) => (
          <button data-nav={`/batches/${year}`}>
            <span>CLASS OF</span>
            <strong>{year}</strong>
            <span>
              {count} {count === 1 ? "classmate" : "classmates"} <Icon name="arrow" size={16} />
            </span>
          </button>
        ))}
      </div>
    )
  }
</main>

<style>
  .batches-empty {
    color: #6b625a;
  }
</style>
