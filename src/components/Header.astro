---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import UserMenu from "./UserMenu";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
const navItems = [
  { label: "The Wall", path: "/wall" },
  { label: "Teachers", path: "/teachers" },
  { label: "News", path: "/news" },
  { label: "Events", path: "/events" },
  { label: "Batches", path: "/batches" },
  { label: "Support the site", path: "/donate" },
];
const normalizedPath = activePath;
const sessionCookie = Astro.cookies.get("balik_session");
const isSignedIn = !!sessionCookie;
---

<header class="site-header" data-session-present={isSignedIn ? "true" : "false"}>
  <div class="header-inner content-width">
    <Logo />
    <nav class="" aria-label="Main navigation">
      {
        navItems.map(item => (
          <button
            class={normalizedPath === item.path ? "nav-active" : ""}
            data-nav={item.path}
          >
            {item.label}
          </button>
        ))
      }
      {isSignedIn && <button class="mobile-account" data-nav="/profile">Profile</button>}
      {isSignedIn && (
        <button class="mobile-account mobile-signout" data-signout>
          Sign out
        </button>
      )}
      {!isSignedIn && (
        <button class="mobile-join" data-nav="/join">
          Join the room <Icon name="arrow" size={17} />
        </button>
      )}
    </nav>
    {!isSignedIn && (
      <button class="header-join" data-nav="/join">
        Join the room <Icon name="arrow" size={16} />
      </button>
    )}
    {isSignedIn && (
      <UserMenu className="header-user-menu" client:load />
    )}
    <button class="menu-toggle" aria-label="Open menu">
      <Icon name="menu" size={25} />
    </button>
  </div>
</header>

<script>
  import { iconPaths } from "./icon-paths";
  import { signOut } from "../lib/auth-client";

  const header = document.querySelector<HTMLElement>(".site-header");
  const navigation = header?.querySelector<HTMLElement>("nav");
  const menuToggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const navButtons = document.querySelectorAll<HTMLButtonElement>("[data-nav]");

  let menuOpen = false;
  let lastY = window.scrollY;

  for (const button of navButtons) {
    button.addEventListener("click", () => {
      const destination = button.dataset.nav;
      if (!destination) return;
      if (destination === "/create" || destination === "/join") {
        if (header?.dataset.sessionPresent === "true") {
          window.location.assign(destination);
        } else {
          (window as any).openAuthModal();
        }
      } else {
        window.location.assign(destination);
      }
    });
  }

  const signOutButton = header?.querySelector<HTMLButtonElement>("[data-signout]");

  signOutButton?.addEventListener("click", async () => {
    if (await signOut()) window.location.reload();
  });

  menuToggle?.addEventListener("click", () => {
    menuOpen = !menuOpen;
    navigation?.classList.toggle("nav-open", menuOpen);
    menuToggle.setAttribute("aria-label", menuOpen ? "Close menu" : "Open menu");
    const menuPath = menuToggle.querySelector("svg path");
    const icon = iconPaths[menuOpen ? "close" : "menu"][0];
    if (menuPath && icon?.type === "path") menuPath.setAttribute("d", icon.d);
  });

  window.addEventListener(
    "scroll",
    () => {
      const currentY = window.scrollY;
      header?.classList.toggle("header-scrolled", currentY > 18);
      header?.classList.toggle(
        "header-hidden",
        currentY > lastY && currentY > 110 && !menuOpen,
      );
      lastY = currentY;
    },
    { passive: true },
  );
</script>
